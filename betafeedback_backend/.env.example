# Copy to .env and adjust. Loaded automatically on startup.
ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/betafeedback?sslmode=disable
JWT_SECRET=dev-secret-change-me
# When true, the email/start endpoint also returns the OTP as debug_code
# (handy for local development alongside or instead of Resend).
OTP_DEBUG=true
# Public web origin used to build shareable links (e.g. project invites).
APP_BASE_URL=https://betafeedback.com
# Google OAuth — Web client for the dashboard and Android; iOS client for the mobile app.
# GOOGLE_CLIENT_ID=123….apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=456….apps.googleusercontent.com
# Firebase service account JSON for FCM push (logs instead of sending when unset).
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# RevenueCat webhook Authorization header (same value configured in the RC dashboard).
# Required in production. In development, webhooks are accepted without auth if unset.
# REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-a-long-random-secret
# Entitlement identifier for Pro (must match RevenueCat → Entitlements).
# REVENUECAT_ENTITLEMENT_ID=pro
# Resend for OTP + notification emails (logs to stdout when unset).
# Create a key at https://resend.com/api-keys and verify your domain.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=BetaFeedback <noreply@betafeedback.com>
# Directory where uploaded feedback attachments (screenshots/recordings) are
# stored and served from. Use a persistent path in production.
MEDIA_DIR=./data/media
# Optional. When set, feedback is classified and structured with the OpenAI API;
# when unset, the backend falls back to local heuristics.
# OPENAI_API_KEY=sk-...
