# Copy to .env and adjust:
#   cp .env.example .env
# Loaded at startup via flutter_dotenv — no --dart-define needed.
# .env is gitignored; Flutter lists it as an asset so the file must exist before run.

# API URL is picked automatically:
#   debug builds  → local backend (localhost / 10.0.2.2 on Android emulator)
#   release builds → https://api.betafeedback.com
#
# For a physical phone on your Wi‑Fi during debug, set your Mac's LAN IP:
# API_BASE_URL_DEBUG=http://192.168.1.42:8080

# Optional Google OAuth overrides (otherwise fetched from GET /v1/auth/config).
# GOOGLE_WEB_CLIENT_ID=….apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=….apps.googleusercontent.com

# RevenueCat public SDK keys (safe to ship in the client).
# REVENUECAT_IOS_API_KEY=appl_…
# REVENUECAT_ANDROID_API_KEY=goog_…
# REVENUECAT_ENTITLEMENT_ID=pro

# Local dev: unlock Pro features in release/profile builds (debug builds skip
# paywalls automatically). Do not set in production release builds you ship.
# BYPASS_PAYWALL=true
